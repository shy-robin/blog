{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write src tests docs scripts \"*.{ts,mjs,json}\" \".*.json\"",
    "format:check": "prettier --check src tests docs scripts \"*.{ts,mjs,json}\" \".*.json\"",
    "test": "esbuild tests/*.test.ts tests/*.test.tsx --bundle --platform=node --packages=external --jsx=automatic --outdir=.test-output --out-extension:.js=.cjs && node --test .test-output/*.test.cjs tests/*.test.mjs",
    "migrate:gainmore": "node scripts/migration/gainmore.mjs",
    "migrate:gainmore:import": "sanity exec scripts/migration/import-gainmore.cjs --with-user-token",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pm2start": "pm2 start npm --name nextjsBlog -- run start",
    "lint": "next lint"
  },
  "dependencies": {
    "@portabletext/react": "^3.2.4",
    "@portabletext/types": "^2.0.15",
    "next": "15.5.29",
    "next-sanity": "^9.12.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sanity": "^3.99.0",
    "server-only": "^0.0.1",
    "shiki": "^3.23.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/import": "3.38.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^8",
    "eslint-config-next": "15.5.29",
    "jsdom": "23.2.0",
    "postcss": "^8",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
